# Local testing / validation credentials for the GetStream.io provider.
#
# Copy to `.env` (gitignored) and fill in a THROWAWAY / dev app's values — never
# a production app, since acceptance tests perform destructive CRUD.
#
#   cp .env.template .env && $EDITOR .env
#   set -a && source .env && set +a          # export into the shell
#
# These four variables are read by the provider (api_key/api_secret directly,
# app_name/app_id as the wrong-app guard). TF_ACC=1 enables the live acceptance
# tests; without it they skip.

# Server-side API key + secret from the Stream dashboard (App > ... > API keys).
# STREAM_API_KEY/SECRET are GetStream's documented names; the Go SDK's
# STREAM_KEY/SECRET are also accepted by the provider.
export STREAM_API_KEY=""
export STREAM_API_SECRET=""

# App identity guard: the provider verifies the credentials resolve to this app.
export STREAM_APP_NAME=""
export STREAM_APP_ID=""

# Enable Terraform acceptance tests (real CRUD). Leave unset to run unit tests only.
export TF_ACC="1"
